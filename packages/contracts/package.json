{
  "name": "@acme/contracts",
  "private": true,
  "type": "module",
  "description": "What the frontend and backend share: route contracts, error codes, pagination (backend scaffold spec \u00a78.1). TypeScript source, no build step.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./client/core": "./src/client/core.ts",
    "./client/public": "./src/client/public.ts"
  },
  "scripts": {
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "fix": "eslint . --fix && prettier --write . --ignore-path ../../.prettierignore",
    "check": "turbo run format lint typecheck knip test"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "knip": "6.38.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
