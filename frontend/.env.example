# Copy to frontend/.env.local (git-ignored) and fill in. Never commit a token.

# The origin secret CloudFront adds to every request. Unset locally; the deployment sets it on the site and the API.
# With it, the site refuses any request without it (src/proxy.ts).
# ORIGIN_SECRET=

# The site's address for canonical and share links (default https://example.com).
SITE_URL=

# The .env files are build inputs in turbo.json, so a change to a key here
# rebuilds.
