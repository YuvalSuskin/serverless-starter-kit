{
  "name": "@acme/sweep",
  "private": true,
  "type": "module",
  "exports": {
    "./prefix": "./src/prefix.ts"
  },
  "description": "pnpm sweep: the deterministic steps of the consistency sweep (spec docs/superpowers/specs/2026-09-30-sweep-design.md). Node runs the TypeScript source directly.",
  "scripts": {
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "fix": "eslint . --fix && prettier --write . --ignore-path ../../.prettierignore",
    "check": "turbo run format lint typecheck knip test"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "knip": "6.38.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
