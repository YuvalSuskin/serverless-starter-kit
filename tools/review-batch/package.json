{
  "name": "@acme/review-batch",
  "private": true,
  "type": "module",
  "description": "pnpm review-batch: validate a review batch's cards and build its review page. Node runs the TypeScript source directly.",
  "scripts": {
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "fix": "eslint . --fix && prettier --write . --ignore-path ../../.prettierignore",
    "check": "turbo run format lint typecheck knip test"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "knip": "6.38.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "marked": "18.0.14",
    "zod": "4.6.5"
  }
}
